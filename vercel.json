{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/audio/:path*",
      "destination": "/audio/:path*"
    },
    {
      "source": "/photos/:path*",
      "destination": "/photos/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
